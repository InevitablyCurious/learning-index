# opencode-honcho's settings for memory-ON cells. Point BENCH_MEMORY_ENV here.
# Each line reaches the worker by name (harness/memory_slot.py); {memory_url}
# becomes the address the cell reaches Honcho at, through the egress sidecar.
HONCHO_BASE_URL={memory_url}

# ONE WORKSPACE PER SERIES. A series starts from empty memory only in a
# workspace no earlier series wrote to: give each new series a new name, and
# keep it for every cell of that series. The ready and cost commands read it
# from here too.
HONCHO_WORKSPACE_ID=learning-index-series-1
