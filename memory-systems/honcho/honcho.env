# Honcho's server settings for Learning-Index. Copy into the Honcho checkout as
# .env (its docker-compose.yml reads it). Everything not set here keeps
# Honcho's own default. Three values are yours to fill: the relay key, and the
# embedding model's id and size.

LOG_LEVEL=INFO

# Local and single-user: no auth. The plugin needs no key either.
AUTH_USE_AUTH=false

# ── The model ───────────────────────────────────────────────────────────────
# Honcho's background jobs run on the SAME local model as the worker, through
# the local relay, under their own alias: `qwen3.6-35b-a3b-memory`, a copy of
# the bench alias pointing at the same upstream model (docs/memory-systems.md).
# Same model, so the relay never swaps models mid-cell; its own alias, so
# Honcho's calls never take the bench alias's slot.
LLM_OPENAI_API_KEY=
DERIVER_MODEL_CONFIG__MODEL=qwen3.6-35b-a3b-memory
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:4545/v1
SUMMARY_MODEL_CONFIG__MODEL=qwen3.6-35b-a3b-memory
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:4545/v1
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=qwen3.6-35b-a3b-memory
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:4545/v1
DREAM_INDUCTION_MODEL_CONFIG__MODEL=qwen3.6-35b-a3b-memory
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:4545/v1
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=qwen3.6-35b-a3b-memory
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:4545/v1
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=qwen3.6-35b-a3b-memory
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:4545/v1
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=qwen3.6-35b-a3b-memory
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:4545/v1
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=qwen3.6-35b-a3b-memory
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:4545/v1
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=qwen3.6-35b-a3b-memory
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:4545/v1
# If the deriver logs structured-output errors, the runtime lacks json_schema
# responses; this asks for plain JSON objects instead.
# DERIVER_MODEL_CONFIG__STRUCTURED_OUTPUT_MODE=json_object

# ── Embeddings ──────────────────────────────────────────────────────────────
# A local embedding model on the runtime, reached directly (not through the
# relay). The dimensions must match the model and are fixed once Honcho's
# database is created: changing models means a fresh database.
EMBEDDING_MODEL_CONFIG__MODEL=
EMBEDDING_VECTOR_DIMENSIONS=
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL=http://host.docker.internal:1234/v1

# ── What the benchmark needs from Honcho ────────────────────────────────────
# Process new messages at once instead of batching them for up to 30 minutes,
# so the queue empties soon after a cell ends and the ready check
# (hooks.py ready) does not stall. A recorded change from Honcho's default.
DERIVER_FLUSH_ENABLED=true

# Report every model call to the telemetry sink (docker-compose.override.yml),
# which totals them for the cost record (hooks.py cost). Nothing leaves the
# machine: the endpoint is the sink.
TELEMETRY_ENABLED=true
TELEMETRY_ENDPOINT=http://telemetry-sink:8795/v1/events
TELEMETRY_HIGH_VOLUME_SAMPLE_RATE=1.0
