# Bench local-proxy configuration (.env is gitignored; keep it local)
# Resolution order for LOCAL_LLM_PROXY_API_KEY (spend_key.py):
#   1) this .env file (LOCAL_LLM_PROXY_API_KEY)
#   2) the process environment (LOCAL_LLM_PROXY_API_KEY)
#   3) ~/.config/opencode/opencode.json -> provider.local-llm-proxy.options.apiKey
#
# LOCAL_LLM_PROXY_API_KEY is the consumer token for the Local LLM Proxy (:4545).
LOCAL_LLM_PROXY_API_KEY=

# Optional override for spend meter DB DSN (default shown below):
# BENCH_SPEND_DB_DSN=postgresql://spend_proxy:spend_proxy_dev@127.0.0.1:5440/spend_proxy
BENCH_SPEND_DB_DSN=

# REMOTE VIEWING — LAN dashboard access (dashboard server).
#   disabled (default) — loopback only.
#   enabled           — reachable from the LAN via ONE specific interface;
#                       the same-origin relay + peer policy gate access.
# Any other value is rejected and the dashboard refuses to start.
#
# The address "enabled" binds/publishes comes from:
#   OKP_BIND_HOST — Docker path: the compose publish host (docker-compose.yml
#                   interpolates it from the shell environment).
#   OKP_DASH_HOST or --host — host process path.
# Fail-closed at startup (no silent coercion):
#   enabled + wildcard (0.0.0.0/::), loopback, or unset address → REFUSED;
#   disabled + a wide OKP_BIND_HOST (wildcard or LAN IP)       → REFUSED.
# NOTE: the dashboard does NOT read this file — there is no shared-file
# mechanism. Export these variables in the shell that launches the dashboard
# or `docker compose`; this entry documents them only.
REMOTE_VIEWING=disabled
# Specific physical LAN address required when REMOTE_VIEWING=enabled,
# e.g. OKP_BIND_HOST=192.168.50.140
OKP_BIND_HOST=
